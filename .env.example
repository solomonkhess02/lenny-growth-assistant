# =============================================================================
# The Lenny Growth Assistant — environment template
# Copy to .env and fill in. .env is git-ignored and must never be committed.
#   cp .env.example .env
# =============================================================================

# --- Provider selection ------------------------------------------------------
# REQUIRED. Which LLM provider the application uses.
#   ollama   = local, no API key, mandated demo path (default)
#   deepseek = cloud, requires DEEPSEEK_API_KEY
LLM_PROVIDER=ollama

# --- Ollama (local) — mandated demo path -------------------------------------
# REQUIRED when LLM_PROVIDER=ollama.
# Use 127.0.0.1, NOT localhost. Measured 2026-08-25: `localhost` resolves to
# ::1 (IPv6) first, Ollama binds IPv4 only, so every new connection stalls
# ~2s before falling back. Raw TCP connect: localhost 2032ms vs 127.0.0.1 0.53ms.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct

# REQUIRED. Read by the Ollama *server* at startup, not by this app.
# Measured on a 4 GB-VRAM GTX 1650: 8192 -> 4.1 GB / 45% CPU / 33 s per call;
# 32768 -> 8.0 GB / 70% CPU / 173 s. Do not raise without re-measuring.
OLLAMA_CONTEXT_LENGTH=8192

# OPTIONAL. Keeps multi-GB model blobs off the system drive.
# OLLAMA_MODELS=D:\OllamaModels

# --- DeepSeek (cloud) --------------------------------------------------------
# REQUIRED when LLM_PROVIDER=deepseek. Get a key: https://platform.deepseek.com/
# NEVER commit a real key. This file holds placeholders only.
DEEPSEEK_API_KEY=sk-replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro

# OPTIONAL. deepseek-v4-pro emits large thinking blocks that can exhaust the
# output budget (observed: 29,995 chars, stop_reason=max_tokens at 8192).
# Either disable thinking or keep max_tokens >= 16384.
DEEPSEEK_DISABLE_THINKING=true
DEEPSEEK_MAX_TOKENS=16384

# --- Embeddings (local, via Ollama) ------------------------------------------
# REQUIRED. Locked 2026-08-25 after measurement. all-minilm is ~20x faster to
# ingest than nomic-embed-text (60s vs ~23min for ~1,935 chunks) with no
# measurable retrieval-quality loss on this corpus (both 5/5 on the probe).
# Documented upgrade: EMBEDDING_MODEL=nomic-embed-text with EMBEDDING_DIM=768.
# Changing either REQUIRES a full re-ingest -- vector spaces are incompatible.
EMBEDDING_MODEL=all-minilm
EMBEDDING_DIM=384

# --- Database ----------------------------------------------------------------
# REQUIRED. Compose supplies this (service name `db`); this value is for
# running the API on the host against Compose's published port.
# 127.0.0.1 for the same IPv6 reason as OLLAMA_BASE_URL above.
DATABASE_URL=postgresql://lenny:CHANGE_ME@127.0.0.1:5432/lenny
POSTGRES_USER=lenny
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lenny

# --- Application -------------------------------------------------------------
# OPTIONAL.
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
