# Keep the build context small. Without this the daemon receives ~202 MB per
# build, most of it backend/.venv (123 MB) which the image never uses.

# Virtualenvs and dependency trees — rebuilt inside the image
backend/.venv/
.venv/
**/node_modules/

# Python bytecode and test caches
**/__pycache__/
**/*.pyc
.pytest_cache/

# Secrets never belong in a build context, image layer, or history.
.env
.env.*
!.env.example

# Version control and editor state
.git/
.gitignore
.claude/
# ...except the Ship 30 skill, which app/ship30.py loads at runtime to build
# the essay system prompt. Without this the skill is absent from the image and
# essay generation fails in `docker compose up` while working on the host --
# the difference showing up only in the graded deployment. Docker's ignore
# rules are last-match-wins, so this negation re-includes it.
!.claude/skills/05-ship30-writing/
.agents/

# Spike artifacts: only the real transcripts and Phase 1 model output are used
# as offline test fixtures. Everything else is bulky evidence.
spike/pi_eval/
spike/captures/
spike/*.py

# The assignment brief is not ours to redistribute (see .gitignore).
*.docx

# Local scratch
*.log
suite.txt
